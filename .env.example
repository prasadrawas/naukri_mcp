# naukri-mcp environment configuration template
# Note: For multi-tenant cloud deployments (e.g. Railway), NO environment variables are required!
# Each user provides their token via the SSE URL: ?rt=YOUR_NAUK_RT_COOKIE

# Optional: For local stdio desktop use
NAUK_RT=""
NAUK_AT=""
MASTER_RESUME_PATH=""
RESUME_PDF_PATH=""

# Server port (Railway sets this dynamically)
PORT=8000
